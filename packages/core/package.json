{
  "name": "@felixfern/num-wasm",
  "version": "0.0.0",
  "description": "NumPy-like array library written in Zig, compiled to WebAssembly for JavaScript/TypeScript",
  "main": "dist/nw.js",
  "types": "dist/nw.d.ts",
  "exports": {
    ".": {
      "types": "./dist/nw.d.ts",
      "require": "./dist/nw.js",
      "default": "./dist/nw.js"
    },
    "./browser": {
      "types": "./dist/nw.browser.d.ts",
      "default": "./dist/nw.browser.js"
    },
    "./dist/num-wasm.wasm": "./dist/num-wasm.wasm"
  },
  "files": [
    "dist",
    "README.md",
    "docs/PLAN.md",
    "docs/USAGE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-wasm.mjs",
    "prepublishOnly": "zig build wasm && pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelixFern/numwasm.git"
  },
  "keywords": [
    "numpy",
    "ndarray",
    "array",
    "wasm",
    "webassembly",
    "zig",
    "neural-network",
    "machine-learning"
  ],
  "author": "felixfern",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "bugs": {
    "url": "https://github.com/FelixFern/numwasm/issues"
  },
  "homepage": "https://github.com/FelixFern/numwasm#readme",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}